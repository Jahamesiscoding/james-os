# Copy to .env locally. Never commit .env or provider credentials.
HOST=127.0.0.1
API_PORT=8787
APP_BASE_URL=http://127.0.0.1:8787
FRONTEND_URL=http://localhost:5173
VITE_API_ORIGIN=http://127.0.0.1:8787
APP_SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Google Cloud OAuth 2.0 Web application. Enable Google Calendar API and Gmail API.
# Add these exact redirect URIs:
# http://127.0.0.1:8787/api/oauth/google/callback
# http://127.0.0.1:8787/api/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SCHOOL_EMAIL_ADDRESS=
SCHOOL_EMAIL_DOMAIN=friendsseminary.org

# Friends Seminary Canvas developer key, issued/approved by the school's Canvas admin.
# Add this exact redirect URI:
# http://127.0.0.1:8787/api/oauth/canvas/callback
CANVAS_BASE_URL=https://friendsseminary.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
